# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=Password@1
DB_NAME=customcraft_furniture

# JWT Configuration
JWT_SECRET=customcraft_super_secret_key_2024_furniture_ecommerce
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=customcraft_refresh_secret_key_2024
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:4200

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=CustomCraft Furniture <noreply@customcraft.com>

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Admin Configuration
ADMIN_DEFAULT_EMAIL=admin@customcraft.com
ADMIN_DEFAULT_PASSWORD=Admin@123
